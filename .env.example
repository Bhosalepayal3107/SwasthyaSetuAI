# SwasthyaSetu AI - PostgreSQL Database Configuration
# You can set either DATABASE_URL or individual PG* variables

# Option 1: Full Connection URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/swasthyasetu

# Option 2: Individual Parameters (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=swasthyasetu
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD

# Set to 'postgres' to use PostgreSQL, or 'sqlite' to fallback to local SQLite
DB_TYPE=postgres
